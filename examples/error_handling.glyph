@module examples.error_handling

@enum DivisionResult {
    Success(Float64),
    DivisionByZero,
}

@fn divide(a: Float64, b: Float64) -> DivisionResult {
    #guard(b != 0.0) else {
        return DivisionResult::DivisionByZero;
    };

    return DivisionResult::Success(a / b);
}

@fn report(result: DivisionResult) -> Void {
    match result {
        | DivisionResult::Success(value) => print("Result: " ++ float_to_string(value))
        | DivisionResult::DivisionByZero => print("Division by zero!")
    }
}

@fn main() -> Void {
    report(divide(10.0, 2.0));
    report(divide(10.0, 0.0));
}
@module calc

@fn add(a: Int64, b: Int64) -> Int64 {
    return a + b;
}

@fn subtract(a: Int64, b: Int64) -> Int64 {
    return a - b;
}

@fn is_even(n: Int64) -> Bool {
    return n % 2 == 0;
}

@test @fn test_add() -> Void {
    assert_eq(add(2, 3), 5, "2 + 3 == 5");
}

@test @fn test_add_negative() -> Void {
    assert_eq(add(-4, 5), 1, "-4 + 5 == 1");
}

@test @fn test_subtract() -> Void {
    assert_eq(subtract(10, 4), 6, "10 - 4 == 6");
}

@test @fn test_float() -> Void {
    assert_eq(1.5 + 1.5, 3.0, "1.5 + 1.5 == 3.0");
}

@test @fn test_string() -> Void {
    assert_eq("hello", "hello", "strings equal");
}

@test @fn test_is_even() -> Void {
    assert_true(is_even(42), "42 is even");
}

@test @fn test_ne() -> Void {
    assert_ne(1, 2, "1 != 2");
}

@test @fn test_fail() -> Void {
    assert(false, "this test should fail");
}
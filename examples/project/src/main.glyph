@use math;
@use geometry;

@fn main() -> Void {
    let a: Float64 = 3.0;
    let b: Float64 = 4.0;

    let sum: Float64 = math::add(a, b);
    print("3 + 4 =");
    print_float(sum);

    let product: Float64 = math::multiply(a, b);
    print("3 * 4 =");
    print_float(product);

    let sq: Float64 = math::square(5.0);
    print("5^2 =");
    print_float(sq);

    let dist: Float64 = geometry::distance(0.0, 0.0, 3.0, 4.0);
    print("distance(0,0,3,4) =");
    print_float(dist);

    println("Module system test passed!");
}
